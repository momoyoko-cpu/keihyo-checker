# Claude APIキー（必須） https://console.anthropic.com で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用モデル（任意。既定: claude-sonnet-4-6）
# 高精度重視なら claude-opus-4-8 / コスト重視なら claude-haiku-4-5-20251001
KEIHYO_MODEL=claude-sonnet-4-6

# ページ並列解析数（任意。既定: 3）
KEIHYO_CONCURRENCY=3

# ポート（任意。Railwayでは自動注入されるため設定不要）
PORT=3000

# PDFレポートの日本語フォントパス（任意。Dockerでは自動検出）
# FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
